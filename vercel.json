# =============================================================================
# Vercel build configuration — Al Mizan Legal Practice
# -----------------------------------------------------------------------------
# This file is auto-detected by Vercel at deploy time. It ensures:
#   1. Prisma client is generated before Next.js builds (so server actions
#      can import @prisma/client)
#   2. DATABASE_URL is exposed to both build + runtime
# =============================================================================

[build]
# `next build` already runs `prisma generate` as a prebuild step (see
# package.json scripts.build). This is a no-op build command.
command = "bun run build"

[functions]
# Increase Node.js memory for Prisma client generation on cold builds
node_bundler = "esbuild"
