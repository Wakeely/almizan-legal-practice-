node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# =============================================================================
# Project-specific dev artifacts — MUST NOT be committed
# =============================================================================

# SQLite database file (contains test users with bcrypt password hashes)
/db/

# Reference UI design source (private; only the ported source under src/ is shared)
/reference-ui/

# Screenshots + dev deliverables (regenerated on every run)
/download/

# Tool output from large file reads (intermediate dev artifacts)
/tool-results/

# Multi-agent shared work log (dev-only; not part of the shipping product)
/worklog.md

# Local-only scripts that contain temporary working data
# (note: scripts/rebrand-to-almizan.sh and scripts/port-landing-auth.sh ARE
#  committed because they document the build process)

# User-uploaded files (screenshots, etc.)
/upload/
