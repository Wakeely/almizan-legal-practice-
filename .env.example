# =============================================================================
# Al Mizan Legal Practice — environment variables
# -----------------------------------------------------------------------------
# Copy this file to .env (local dev) or set these values in your Vercel
# project's Environment Variables UI for production.
# =============================================================================

# ----- Database -------------------------------------------------------------
# Local dev (SQLite):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production (Vercel): set DATABASE_URL to your Vercel Postgres / Neon /
# Supabase connection string. Example:
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# (Vercel Postgres auto-injects this when you create a Postgres store and
# link it to your project — you don't need to copy it manually.)


# ----- NextAuth -------------------------------------------------------------
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# The canonical URL of your deployment. Must match exactly (incl. https://).
NEXTAUTH_URL=http://localhost:3000


# ----- Gemini AI (server-side only) ----------------------------------------
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# Leave empty to disable AI features; AI module returns a friendly stub.
# Used for BOTH text generation (callGemini) AND RAG embeddings (text-embedding-004).
GEMINI_API_KEY=


# ----- Legal RAG (Jordan) ---------------------------------------------------
# Production only — requires Postgres + pgvector. Run once after `prisma db push`:
#   psql "$DATABASE_URL" -f prisma/sql/rag_pgvector_setup.sql
# Then seed the corpus:
#   GEMINI_API_KEY=... bun run rag:seed
#
# Local dev (SQLite) needs NOTHING extra — the dev schema omits the embedding
# column and retrieve.ts falls back to text search. RAG still works for
# keyword queries; semantic search is unavailable until you run against
# Postgres + pgvector.
