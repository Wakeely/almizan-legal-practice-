# =============================================================================
# Al Mizan Legal Practice — environment variables
# -----------------------------------------------------------------------------
# Copy this file to .env (local dev) or set these values in your Vercel
# project's Environment Variables UI for production.
# =============================================================================

# ----- Database -------------------------------------------------------------
# Local dev (SQLite):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production (Vercel): set DATABASE_URL to your Vercel Postgres / Neon /
# Supabase connection string. Example:
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# (Vercel Postgres auto-injects this when you create a Postgres store and
# link it to your project — you don't need to copy it manually.)


# ----- NextAuth -------------------------------------------------------------
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# The canonical URL of your deployment. Must match exactly (incl. https://).
NEXTAUTH_URL=http://localhost:3000


# ----- Gemini AI (server-side only) ----------------------------------------
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# Leave empty to disable AI features; AI module returns a friendly stub.
# Used for BOTH text generation (callGemini) AND RAG embeddings (gemini-embedding-001).
GEMINI_API_KEY=


# ----- OpenAI (fallback text generation — optional) -------------------------
# When all Gemini text models fail (quota exhausted, model deprecated for new
# keys), the app falls back to OpenAI GPT-4o-mini.
# Get a key: https://platform.openai.com/api-keys (requires billing setup)
OPENAI_API_KEY=


# ----- Groq (FREE fallback text generation — recommended, no card needed) ----
# Groq offers a GENUINELY FREE API with no credit card required:
#   - 14,000 requests/day on Llama 3.3 70B (handles Arabic well)
#   - 30 requests/minute on Mixtral/Gemma
#
# This is the best option if you can't enable billing on Google/OpenAI.
# Get a FREE key: https://console.groq.com/keys
#
# Fallback order: Gemini → OpenAI → Groq. As long as ANY provider has quota,
# RAG answers generate successfully.
GROQ_API_KEY=


# ----- Legal RAG (Jordan) ---------------------------------------------------
# Production only — requires Postgres + pgvector. Run once after `prisma db push`:
#   psql "$DATABASE_URL" -f prisma/sql/rag_pgvector_setup.sql
# Then seed the corpus:
#   GEMINI_API_KEY=... bun run rag:seed
#
# Local dev (SQLite) needs NOTHING extra — the dev schema omits the embedding
# column and retrieve.ts falls back to text search. RAG still works for
# keyword queries; semantic search is unavailable until you run against
# Postgres + pgvector.

# Temporary kill-switch for the no-terminal browser seed endpoint
# (POST /api/ai/rag/seed). Set to "1" to let a Managing Partner seed the
# Jordanian corpus from the AI module UI. Set to "0" or unset to lock the
# endpoint down (returns 403 even for admins). See README "Setup (production
# — Vercel Postgres, NO TERMINAL)" Step 3.
RAG_SEED_ENABLED=0


# ----- Jordanian Law MCP (verbatim statute retrieval) ----------------------
# The Jordanian Law MCP Server (https://github.com/Ansvar-Systems/jordanian-law-mcp)
# provides verbatim official statute text, citation validation, and currency
# checks. The adapter in src/lib/mcp/jordanian-law.ts talks to it.
#
# SELF-HOSTED (recommended for production with real client data):
#   Deploy your own instance and set MCP_ENDPOINT to its URL.
#   MCP_ENDPOINT=https://your-self-hosted-url/mcp
#   MCP_API_KEY=your-key-if-required
#
# HOSTED (for testing only — do NOT send real client data):
#   Leave MCP_ENDPOINT unset. The adapter uses the public hosted endpoint.
#   Only public legal queries (law name + article number) are ever sent —
#   no client documents or matter-specific content is transmitted.
#
# If unset/unreachable, the AI routes fall back gracefully to the local
# RAG corpus (31 curated articles). Tool calls are logged via audit().
MCP_ENDPOINT=
MCP_API_KEY=
